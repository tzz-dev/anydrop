# Base ws(s):// URL of the deployed signaling Worker (apps/worker), no trailing
# slash and no path — the client appends /connect itself.
# Local dev default matches `wrangler dev`'s default port.
NEXT_PUBLIC_SIGNAL_URL=ws://127.0.0.1:8787

# Google Analytics 4 measurement ID. Optional — leave empty to disable GA.
NEXT_PUBLIC_GA_ID=

# Optional JSON array of RTCIceServer objects that replaces the default public
# STUN server — use this to add a TURN server for networks where direct
# peer-to-peer connections fail. Example:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
NEXT_PUBLIC_ICE_SERVERS=
