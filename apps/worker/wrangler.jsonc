{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anydrop-signal",
  "main": "src/index.ts",
  // Required secret (not stored here): `wrangler secret put ROOM_SALT`.
  // For local dev copy .dev.vars.example to .dev.vars.
  // ALLOWED_ORIGINS (comma-separated) restricts which websites may open
  // signaling sockets. Locally, override it in .dev.vars (empty = allow all).
  "vars": {
    "ALLOWED_ORIGINS": "https://anydrop.jp,https://www.anydrop.jp"
  },
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ANYDROP_ROOM",
        "class_name": "AnydropRoom"
      }
    ]
  },
  // Private-room join attempts: 20 per minute per client network (see join-limit.ts).
  "ratelimits": [
    {
      "name": "JOIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnydropRoom"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
