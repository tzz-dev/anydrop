# Base ws(s):// URL of the deployed signaling Worker (apps/worker), no trailing
# slash and no path — the client appends /connect itself.
# Local dev default matches `wrangler dev`'s default port.
NEXT_PUBLIC_SIGNAL_URL=ws://127.0.0.1:8787

# Google Analytics 4 measurement ID. Optional — leave empty to disable GA.
NEXT_PUBLIC_GA_ID=
